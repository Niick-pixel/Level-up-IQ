{
  "name": "mind-gym",
  "productName": "Mind Gym",
  "version": "0.2.0",
  "description": "Brain training and curiosity: puzzles, games, a searchable keyword bank, and anti-AI-dependence exercises. Offline-first, private, no telemetry.",
  "main": "src/main/main.js",
  "author": "Nicolas",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\" \"test/*.test.mjs\"",
    "keywords:build": "node scripts/build-keywords.js",
    "words:build": "node scripts/build-words.js",
    "icons": "node scripts/make-icons.js",
    "dist": "electron-builder --win nsis --publish never",
    "countries:build": "node scripts/build-countries.js",
    "verify:providers": "node scripts/verify-providers.js"
  },
  "build": {
    "appId": "com.mindgym.app",
    "productName": "Mind Gym",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Mind Gym",
      "artifactName": "MindGym-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Niick-pixel",
        "repo": "Level-up-IQ"
      }
    ]
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "electron-updater": "^6.8.9",
    "flag-icons": "^7.5.0",
    "fuse.js": "^7.5.0"
  },
  "devDependencies": {
    "an-array-of-english-words": "^2.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Niick-pixel/Level-up-IQ.git"
  }
}
